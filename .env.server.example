# ==============================================================================
# PT-RAG Server Deployment Configuration (.env)
#
# Use this configuration when running PT-RAG and Qdrant on the same server
# as the NVIDIA Nemotron LLM endpoint.
# ==============================================================================

# ── Local NVIDIA Nemotron LLM Server (running on port 8000) ──
AZURE_CNLP_MEDGEMMA__ENDPOINTS__0__NAME=primary
AZURE_CNLP_MEDGEMMA__ENDPOINTS__0__API_URL=http://127.0.0.1:8000/v1
AZURE_CNLP_MEDGEMMA__ENDPOINTS__0__MODEL=nvidia/Nemotron-3-Nano-Omni-30B-A3B-Reasoning-NVFP4
AZURE_CNLP_MEDGEMMA__ENDPOINTS__0__API_KEY=EMPTY

# ── Local Qdrant Vector Store (running on port 6333) ──
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=pt_books

# ── Embeddings & Model Parameters ──
EMBEDDING_MODEL=all-MiniLM-L6-v2
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=120
LLM_TEMPERATURE=0.2
