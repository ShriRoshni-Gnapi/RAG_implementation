# Vector store settings for pt_rag (Qdrant).
#
# Copy this file to .env and adjust if needed:
#     Copy-Item .env.example .env
#
# .env is git-ignored and must NEVER be committed.

# Qdrant server. Start it with:
#   docker run -d --name pt_rag_qdrant -p 6333:6333 -p 6334:6334 \
#     -v pt_rag_qdrant_data:/qdrant/storage qdrant/qdrant
QDRANT_URL=http://localhost:6333

# Only needed for Qdrant Cloud / a secured instance. Leave blank locally.
QDRANT_API_KEY=

# Seconds before a Qdrant request times out.
QDRANT_TIMEOUT=60

# Collections are named <prefix><book_key>, e.g. ptbook_paz_acute_care
COLLECTION_PREFIX=ptbook_

# ---------------------------------------------------------------- LLM Generation (NVIDIA Nemotron / OpenAI-compatible vLLM)
NVIDIA_API_URL=http://46.4.179.126:8000/v1
NVIDIA_MODEL=nvidia/Nemotron-3-Nano-Omni-30B-A3B-Reasoning-NVFP4
NVIDIA_API_TOKEN=

# Or using generic/legacy variable aliases:
# AZURE_CNLP_MEDGEMMA__ENDPOINTS__0__API_URL=http://46.4.179.126:8000/v1
# AZURE_CNLP_MEDGEMMA__ENDPOINTS__0__MODEL=nvidia/Nemotron-3-Nano-Omni-30B-A3B-Reasoning-NVFP4
# LLM_TIMEOUT=180
# LLM_TEMPERATURE=0.2
# LLM_MAX_TOKENS=1024

