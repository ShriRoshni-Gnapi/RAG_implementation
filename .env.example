# Vector store settings for pt_rag (Qdrant).
#
# Copy this file to .env and adjust if needed:
#     Copy-Item .env.example .env
#
# .env is git-ignored and must NEVER be committed.

# Qdrant server. Start it with:
#   docker run -d --name pt_rag_qdrant -p 6333:6333 -p 6334:6334 \
#     -v pt_rag_qdrant_data:/qdrant/storage qdrant/qdrant
QDRANT_URL=http://localhost:6333

# Only needed for Qdrant Cloud / a secured instance. Leave blank locally.
QDRANT_API_KEY=

# Seconds before a Qdrant request times out.
QDRANT_TIMEOUT=60

# Collections are named <prefix><book_key>, e.g. ptbook_paz_acute_care
COLLECTION_PREFIX=ptbook_
